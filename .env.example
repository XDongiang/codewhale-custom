# ══ 华师 AI 工作台 环境变量模板 ══
# 复制为 .env 后按需修改;不要提交真实密码/token。

# ── 服务端(ccnu-ai-server)──
# 生产端口 3001(同源迁移要求),本地开发建议 8090
APP_PORT=3001
# 服务端 → CodeWhale Runtime 凭证(与 codewhale serve --auth-token 保持一致;浏览器不再持有)
AUTH_TOKEN=dev-token
# CodeWhale Runtime(一般不用改)
RUNTIME_URL=http://127.0.0.1:7878
# 首次启动创建初始管理员 admin 的密码(≥8 位);不设置则随机生成并仅在启动时打印一次
# ADMIN_PASSWORD=change-me-please
# 用户会话有效期(天),默认 30
# SESSION_TTL_DAYS=30
# 服务端持久化目录(部署时不要覆盖该目录;含名单/报告/用户/会话)
DATA_DIR=./server/data
# 生产静态目录,默认用 web-workbench/dist
# STATIC_DIR=./web-workbench/dist
# 小红书 / 邮件 CLI 路径(如 .venv/bin/xhs)
XHS_BIN=xhs
AGENTLY_CLI_BIN=agently-cli

# ── 前端(web-workbench)VITE_* 前缀变量由 Vite 内联 ──
# 登录账号由管理员在「设置 → 用户管理」创建;前端不再需要共享 token
# VITE_RUNTIME_API_URL=auto
