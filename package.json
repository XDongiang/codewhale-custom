{
  "name": "codewhale-custom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web-workbench",
    "server"
  ],
  "scripts": {
    "build": "npm run build -w server && npm run build -w web-workbench",
    "start": "npm run start -w server",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web-workbench",
    "typecheck": "npm run typecheck -ws",
    "test": "npm run test -w server"
  }
}
